        "name": "on/off ?",
        "func": "let off_state = { \"r\": 0, \"g\": 0, \"b\": 0 };\nfunction isEqual(a, b) {\n    for(let c in a) {\n        if (a[c] != b[c]) {\n            return false;\n        }\n    }\n    return true;\n}\nif (isEqual(msg.payload.d.color, off_state)) {\n    msg.payload = false;\n} else {\n    msg.payload = true;\n}\n\nreturn msg;",
