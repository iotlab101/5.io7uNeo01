        "func": "if (msg.payload) {\n    msg.payload = {\n        \"d\": {\n            \"color\": {\n                \"r\": 255,\n                \"g\": 35,\n                \"b\": 0\n            }\n        }\n    }\n} else {\n    msg.payload = {\n        \"d\": {\n            \"color\": {\n                \"r\": 0,\n                \"g\": 0,\n                \"b\": 0\n            }\n        }\n    }\n}\n\nreturn msg;",
